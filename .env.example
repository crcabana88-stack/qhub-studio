# QHUB Studio — Environment Variables
# Copy to .env for local dev. NEVER commit .env to git.
# Production values live in AWS Secrets Manager / Fly.io secrets.

# ── QHUB Governance ───────────────────────────────────────────────────────────
# QHUB_LEDGER_INGEST_URL — direct execute-api URL for POST /events (server-to-server only)
# This is the ingest endpoint. NEVER expose to browser. Set in Fly.io/Cloudflare secrets.
QHUB_LEDGER_INGEST_URL=https://2tabblt3ld.execute-api.us-east-1.amazonaws.com
# QHUB_API_BASE — reader API base URL (GET /chains). Falls back to QHUB_LEDGER_INGEST_URL.
QHUB_API_BASE=https://2tabblt3ld.execute-api.us-east-1.amazonaws.com
# QHUB_HMAC_SECRET — HMAC-SHA256 signing key. NEVER commit. Get from 1Password / AWS Secrets Manager.
QHUB_HMAC_SECRET=                    # per-org HMAC-SHA256 key — from AWS Secrets Manager

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Gate 04 simulation adapters — staging-only, fail-closed. Never enable on a
# production/customer deployment.
QHUB_ENABLE_GATE04_SIMULATION_ADAPTERS=0
QHUB_DEPLOY_ENV=development
QHUB_PUBLIC_HOSTNAME=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=                   # public anon key (safe in browser)
SUPABASE_SERVICE_ROLE_KEY=           # server-only — NEVER expose to client

# ── LLM Providers (users bring their own, stored per-org) ─────────────────────
# In QHUB Studio, API keys are org-managed (not per-user browser cookies).
# Set these as org defaults; users can override in settings.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
VITE_LOG_LEVEL=debug
PORT=5173
