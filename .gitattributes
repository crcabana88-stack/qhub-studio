# Normalize line endings to LF in the repo and force LF in the working tree,
# overriding core.autocrlf=true on Windows checkouts. The ESLint config enforces
# 'linebreak-style: unix' and prettier/prettier defaults to LF, so a CRLF working
# copy makes every source file fail lint. Keeping the working tree LF lets the
# husky pre-commit hook (typecheck + eslint) run cleanly on Windows.

# Source
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf

# Config / data / docs
*.json  text eol=lf
*.jsonc text eol=lf
*.md    text eol=lf
*.mdx   text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Shell scripts MUST use LF regardless of the checkout platform.
# On Windows (core.autocrlf=true) a CRLF shebang breaks execution in Docker/Linux.
*.sh text eol=lf
bindings.sh text eol=lf

# SQL artifacts are hash-pinned: release packages record and verify the exact
# SHA-256 of the .sql files an operator pastes. Without this rule core.autocrlf
# rewrites them with CRLF on checkout, which changes their bytes and breaks every
# recorded hash while the committed blob is unchanged. Pinning eol=lf keeps SQL
# artifacts byte-stable across checkouts on every platform.
*.sql text eol=lf
